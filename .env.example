# Copy this file to .env and fill in your Firebase project's Web app config
# (Firebase Console -> Project settings -> General -> Your apps -> Web app).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# From Firebase Console -> Authentication -> Sign-in method -> Google ->
# Web SDK configuration (or Google Cloud Console -> Credentials).
# Google Sign-In stays disabled (button greyed out) until the ID for the
# current platform is set: EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID for web/Android,
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID for iOS (its own OAuth client, from Google
# Cloud Console -> Credentials -> iOS client, or Firebase's GoogleService-Info.plist).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
