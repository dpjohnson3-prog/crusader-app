# Copy this file to .env and fill in your Firebase project's Web app config
# (Firebase Console -> Project settings -> General -> Your apps -> Web app).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# From Firebase Console -> Authentication -> Sign-in method -> Google ->
# Web SDK configuration (or Google Cloud Console -> Credentials).
# Google Sign-In stays disabled (button greyed out) until this is set.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
